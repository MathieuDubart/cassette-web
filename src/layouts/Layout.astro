---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Cassette · Native Subsonic and OpenSubsonic client for iOS and macOS",
  description = "A beautiful native iOS and macOS app for your self-hosted music. Built for Navidrome, Subsonic, OpenSubsonic. Open source, offline-first, no tracking.",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(`${import.meta.env.BASE_URL}/og-image.png`.replace(/\/+/g, "/"), Astro.site).toString();

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "MobileApplication",
  name: "Cassette",
  operatingSystem: "iOS, macOS",
  applicationCategory: "MusicApplication",
  description,
  url: canonicalURL,
  author: {
    "@type": "Person",
    name: "Mathieu Dubart",
  },
  offers: {
    "@type": "Offer",
    availability: "https://schema.org/PreOrder",
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0F0D1A" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}/images/cassette-icon-1024.png`.replace(/\/+/g, "/")} />
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body class="min-h-dvh bg-bg-primary text-text-primary antialiased">
    <!-- Scroll progress bar -->
    <div id="scroll-progress" aria-hidden="true"></div>

    <slot />

    <script>
      /* ── Scroll progress ─────────────────────────────── */
      const bar = document.getElementById("scroll-progress");
      const updateBar = () => {
        if (!bar) return;
        const max = document.body.scrollHeight - window.innerHeight;
        bar.style.width = max > 0 ? ((window.scrollY / max) * 100).toFixed(2) + "%" : "0%";
      };
      window.addEventListener("scroll", updateBar, { passive: true });

      /* ── Scroll-triggered reveal ─────────────────────── */
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          }
        },
        { rootMargin: "0px 0px -8% 0px", threshold: 0.06 }
      );

      const reveal = () => {
        document.querySelectorAll(".reveal:not(.is-visible)").forEach((el) => {
          observer.observe(el);
        });
      };

      reveal();
      document.addEventListener("astro:page-load", reveal);
    </script>
  </body>
</html>
