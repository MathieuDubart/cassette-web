---
const issuesUrl = "https://github.com/MathieuDubart/Cassette/issues";

type Status = "tested" | "compatible";

interface Server {
  name: string;
  status: Status;
}

const servers: Server[] = [
  { name: "Navidrome",         status: "tested" },
  { name: "Subsonic",          status: "tested" },
  { name: "Airsonic",          status: "tested" },
  { name: "Airsonic-Advanced", status: "tested" },
  { name: "Gonic",             status: "tested" },
  { name: "Funkwhale",         status: "tested" },
  { name: "Ampache",           status: "tested" },
  { name: "LMS",               status: "tested" },
  { name: "Astiga",            status: "compatible" },
  { name: "Booksonic",         status: "compatible" },
  { name: "Madsonic",          status: "compatible" },
  { name: "Supysonic",         status: "compatible" },
];
---

<section
  id="server-compatibility"
  class="sc-section"
  aria-label="Server compatibility"
>
  <div class="sc-inner">

    <p class="reveal sc-eyebrow">
      <span class="eyebrow-dot"></span>
      Works with
    </p>

    <h2 class="reveal sc-heading">Bring your own server.</h2>

    <p class="reveal sc-body">
      Cassette connects to any Subsonic-compatible server. You own your
      library, your files, and your data.
    </p>

    <ul class="sc-grid" role="list">
      {
        servers.map((server, i) => (
          <li
            class="server-card reveal"
            style={`transition-delay: ${i * 40}ms`}
          >
            <span class="card-name">{server.name}</span>
            {server.status === "tested" ? (
              <span class="badge badge-tested" title="Tested by the Cassette team" aria-label="Tested">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="badge-icon" aria-hidden="true">
                  <path d="M3 8.5l3.5 3.5L13 5" />
                </svg>
                Tested
              </span>
            ) : (
              <span class="badge badge-compatible" title="Implements the Subsonic API — should work" aria-label="Compatible">
                <span class="compat-dot" aria-hidden="true"></span>
                Compatible
              </span>
            )}
          </li>
        ))
      }
    </ul>

    <p class="reveal sc-note">
      Don't see your server? If it implements the Subsonic API, it'll work.{" "}
      <a
        href={issuesUrl}
        rel="noopener"
        target="_blank"
        class="sc-link"
      >Open an issue on GitHub</a> if you hit anything unexpected.
    </p>

  </div>
</section>

<style>
  /* ── Section ─────────────────────────────────────────── */
  .sc-section {
    background-color: var(--color-bg-secondary);
  }

  .sc-inner {
    max-width: 80rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
    padding-block: 5rem;
  }

  @media (min-width: 640px)  { .sc-inner { padding-inline: 2rem; padding-block: 6rem; } }
  @media (min-width: 1024px) { .sc-inner { padding-block: 8rem; } }

  /* ── Eyebrow ─────────────────────────────────────────── */
  .sc-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-primary);
    margin: 0 0 1.25rem;
  }

  .eyebrow-dot {
    display: inline-block;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background-color: currentColor;
    flex-shrink: 0;
  }

  /* ── Heading & body ──────────────────────────────────── */
  .sc-heading {
    font-size: clamp(1.875rem, 4.5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.08;
    color: var(--color-text-primary);
    margin: 0 0 1rem;
    transition-delay: 60ms;
  }

  .sc-body {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    max-width: 38rem;
    margin: 0 0 3rem;
    transition-delay: 100ms;
  }

  /* ── Server grid ─────────────────────────────────────── */
  .sc-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0 0 2.5rem;
  }

  @media (min-width: 560px) { .sc-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 900px) { .sc-grid { grid-template-columns: repeat(4, 1fr); gap: 1rem; } }

  /* ── Server card ─────────────────────────────────────── */
  .server-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    border-radius: 1rem;
    border: 1px solid var(--color-border-subtle);
    background-color: var(--color-bg-tertiary);
    transition:
      opacity  0.5s ease-out,
      transform 0.5s ease-out,
      border-color 0.2s ease;
  }

  .server-card:hover {
    border-color: rgba(108, 71, 245, 0.4);
  }

  .card-name {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text-primary);
  }

  /* ── Badges ──────────────────────────────────────────── */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .badge-icon {
    width: 0.75rem;
    height: 0.75rem;
  }

  .badge-tested    { color: var(--color-accent-primary); }
  .badge-compatible { color: var(--color-text-tertiary); }

  .compat-dot {
    display: inline-block;
    width: 0.3125rem;
    height: 0.3125rem;
    border-radius: 50%;
    background-color: currentColor;
  }

  /* ── Footer note ─────────────────────────────────────── */
  .sc-note {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 38rem;
    margin: 0;
    transition-delay: 120ms;
  }

  .sc-link {
    color: var(--color-text-primary);
    text-decoration: underline;
    text-decoration-color: var(--color-border-subtle);
    text-underline-offset: 3px;
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
  }

  .sc-link:hover {
    color: var(--color-accent-fg);
    text-decoration-color: var(--color-accent-primary);
  }
</style>
