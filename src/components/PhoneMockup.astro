---
interface Props {
  src?: string;
  alt: string;
  tilt?: "left" | "right" | "none";
}

const { src, alt, tilt = "none" } = Astro.props;

const tiltClass =
  tilt === "left" ? "phone-tilt-left" : tilt === "right" ? "phone-tilt-right" : "";
---

<div class={`phone-mockup ${tiltClass}`} role="img" aria-label={alt}>
  <div class="phone-frame">
    <div class="phone-side-button phone-side-button--mute" aria-hidden="true"></div>
    <div class="phone-side-button phone-side-button--volume-up" aria-hidden="true"></div>
    <div class="phone-side-button phone-side-button--volume-down" aria-hidden="true"></div>
    <div class="phone-side-button phone-side-button--power" aria-hidden="true"></div>

    <div class="phone-screen">
      {
        src ? (
          <img
            src={src}
            alt={alt}
            loading="lazy"
            decoding="async"
            class="phone-screen-image"
          />
        ) : (
          <div class="phone-screen-placeholder" aria-hidden="true">
            <span>iPhone screenshot</span>
          </div>
        )
      }
      <div class="phone-dynamic-island" aria-hidden="true"></div>
    </div>
  </div>
</div>

<style>
  .phone-mockup {
    --phone-width: 280px;
    --phone-frame-color: #1a1714;
    --phone-frame-highlight: #3a332b;
    --phone-bezel: calc(var(--phone-width) * 0.032);
    --phone-radius: calc(var(--phone-width) * 0.16);
    --phone-screen-radius: calc(var(--phone-radius) - var(--phone-bezel) * 0.7);

    width: 100%;
    max-width: var(--phone-width);
    aspect-ratio: 1290 / 2796;
    will-change: transform;
    filter: drop-shadow(0 25px 50px rgba(255, 127, 63, 0.18))
      drop-shadow(0 12px 24px rgba(26, 23, 20, 0.18));
  }

  @media (min-width: 768px) {
    .phone-mockup {
      --phone-width: 320px;
    }
  }

  @media (min-width: 1024px) {
    .phone-mockup {
      --phone-width: 360px;
    }
  }

  .phone-frame {
    position: relative;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      135deg,
      #2a2521 0%,
      #1a1714 35%,
      #0f0d0b 65%,
      #2a2521 100%
    );
    border-radius: var(--phone-radius);
    padding: var(--phone-bezel);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.06),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }

  .phone-screen {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: var(--phone-screen-radius);
    overflow: hidden;
    background: #000;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.6);
  }

  .phone-screen-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .phone-screen-placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background: var(--color-accent-soft);
    color: var(--color-text-tertiary);
    font-style: italic;
    font-size: 0.95rem;
    letter-spacing: -0.01em;
  }

  .phone-dynamic-island {
    position: absolute;
    top: calc(var(--phone-width) * 0.032);
    left: 50%;
    transform: translateX(-50%);
    width: calc(var(--phone-width) * 0.31);
    height: calc(var(--phone-width) * 0.092);
    background: #000;
    border-radius: 999px;
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.04),
      0 1px 2px rgba(0, 0, 0, 0.6);
  }

  .phone-side-button {
    position: absolute;
    background: linear-gradient(
      90deg,
      #0a0908 0%,
      #2a2521 50%,
      #0a0908 100%
    );
    border-radius: 1px;
  }

  .phone-side-button--mute {
    left: calc(var(--phone-bezel) * -0.5);
    top: 13%;
    width: calc(var(--phone-bezel) * 0.9);
    height: calc(var(--phone-width) * 0.07);
  }

  .phone-side-button--volume-up {
    left: calc(var(--phone-bezel) * -0.5);
    top: 22%;
    width: calc(var(--phone-bezel) * 0.9);
    height: calc(var(--phone-width) * 0.11);
  }

  .phone-side-button--volume-down {
    left: calc(var(--phone-bezel) * -0.5);
    top: 32%;
    width: calc(var(--phone-bezel) * 0.9);
    height: calc(var(--phone-width) * 0.11);
  }

  .phone-side-button--power {
    right: calc(var(--phone-bezel) * -0.5);
    top: 25%;
    width: calc(var(--phone-bezel) * 0.9);
    height: calc(var(--phone-width) * 0.16);
  }

  .phone-tilt-left {
    transform: rotate(-2deg);
  }

  .phone-tilt-right {
    transform: rotate(2deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .phone-tilt-left,
    .phone-tilt-right {
      transform: none;
    }
  }
</style>
