---
const currentYear = new Date().getFullYear();
const logoUrl = `${import.meta.env.BASE_URL}/images/cassette-icon-1024.png`.replace(/\/+/g, "/");
---

<footer class="border-t border-border-subtle bg-bg-secondary/40">
  <div class="mx-auto w-full max-w-7xl px-6 py-12 sm:px-8">
    <div class="flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
      <a href="#" class="inline-flex items-center gap-2 text-base font-semibold tracking-tight text-text-primary" aria-label="Cassette home">
        <img
          src={logoUrl}
          alt=""
          width="32"
          height="32"
          loading="lazy"
          decoding="async"
          class="h-8 w-8 rounded-lg"
        />
        <span>Cassette</span>
      </a>

      <nav aria-label="Footer">
        <ul class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-text-secondary">
          <li>
            <a
              href="https://github.com/MathieuDubart/Cassette"
              rel="noopener"
              target="_blank"
              class="transition-colors hover:text-text-primary">GitHub</a
            >
          </li>
          <li>
            <a
              href="https://mathieu-dubart.fr"
              rel="noopener"
              target="_blank"
              class="transition-colors hover:text-text-primary">Made by Mathieu Dubart</a
            >
          </li>
          <li>
            <a
              href="https://mathieudubart.github.io/swiftsonic-landing/"
              rel="noopener"
              target="_blank"
              class="transition-colors hover:text-text-primary">SwiftSonic</a
            >
          </li>
          <li>
            <a
              href="mailto:support@getcassette.app"
              class="transition-colors hover:text-text-primary">Contact</a
            >
          </li>
          <li>
            <a
              href="/survey"
              class="transition-colors hover:text-text-primary">Share feedback</a
            >
          </li>
        </ul>
      </nav>
    </div>

    <div class="mt-10 flex flex-col items-start justify-between gap-2 border-t border-border-subtle pt-8 text-xs text-text-tertiary md:flex-row md:items-center">
      <p>Built by Mathieu Dubart · Made in France 🇫🇷</p>
      <p>© {currentYear} · MPL-2.0</p>
    </div>
  </div>
</footer>
