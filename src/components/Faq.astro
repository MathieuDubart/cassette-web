---
// Answers are drawn from existing, verified site copy — no new claims.
// The visible text and the FAQPage schema below are kept identical so the
// structured data always matches what's on the page (Google requirement).
const faqs = [
  {
    q: "What is Cassette?",
    a: "Cassette is a native iOS and macOS music client for Subsonic and OpenSubsonic servers. It lets you stream and download your self-hosted music library on iPhone and Mac, with a fast, beautiful interface built entirely in Swift and SwiftUI.",
  },
  {
    q: "Which servers does Cassette work with?",
    a: "Cassette connects to any Subsonic-compatible or OpenSubsonic-compatible server. You bring your own server and keep full ownership of your library, your files, and your data.",
  },
  {
    q: "Is Cassette free and open source?",
    a: "Yes. Cassette is open source under the MPL-2.0 license — there are no accounts to create, no ads, and no tracking or telemetry.",
  },
  {
    q: "Can I listen to my music offline?",
    a: "Yes. You can download albums and playlists for true offline playback. Your library, search, queue, and favorites keep working even when there is no connection.",
  },
  {
    q: "How do I install Cassette on iPhone or Mac?",
    a: "On iPhone, join the TestFlight beta. On macOS, install it with Homebrew — run brew tap MathieuDubart/cassette, then brew install --cask cassette.",
  },
  {
    q: "What audio formats does Cassette support?",
    a: "Cassette supports FLAC and lossless audio, with badges so you always know what you are hearing, plus AirPlay and full lock screen and Now Playing controls.",
  },
];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<section id="faq" class="faq-section" aria-label="Frequently asked questions">
  <div class="faq-inner">

    <p class="reveal faq-eyebrow">
      <span class="eyebrow-dot"></span>
      FAQ
    </p>

    <h2 class="reveal faq-heading">Frequently asked questions</h2>

    <div class="faq-list">
      {
        faqs.map((f, i) => (
          <details class="faq-item reveal" style={`--delay: ${i * 60}ms`}>
            <summary class="faq-q">
              <h3 class="faq-q-text">{f.q}</h3>
              <span class="faq-icon" aria-hidden="true">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                  <path d="M8 3v10M3 8h10" />
                </svg>
              </span>
            </summary>
            <div class="faq-a">
              <p>{f.a}</p>
            </div>
          </details>
        ))
      }
    </div>

  </div>
</section>

<script
  type="application/ld+json"
  set:html={JSON.stringify(faqJsonLd)}
  is:inline
/>

<style>
  .faq-section {
    background-color: var(--color-bg-secondary);
  }

  .faq-inner {
    max-width: 48rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
    padding-block: 5rem;
  }

  @media (min-width: 640px)  { .faq-inner { padding-inline: 2rem; } }
  @media (min-width: 1024px) { .faq-inner { padding-block: 7.5rem; } }

  /* ── Eyebrow + heading ───────────────────────────────── */
  .faq-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-primary);
    margin: 0 0 1.25rem;
  }

  .eyebrow-dot {
    display: inline-block;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background-color: currentColor;
    flex-shrink: 0;
  }

  .faq-heading {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--color-text-primary);
    margin: 0 0 2.5rem;
    transition-delay: 60ms;
  }

  /* ── List ────────────────────────────────────────────── */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-item {
    border: 1px solid var(--color-border-subtle);
    border-radius: 1rem;
    background-color: var(--color-bg-tertiary);
    overflow: hidden;
    transition:
      opacity 600ms cubic-bezier(0.16, 1, 0.3, 1) var(--delay, 0ms),
      transform 600ms cubic-bezier(0.16, 1, 0.3, 1) var(--delay, 0ms),
      border-color 0.2s ease;
  }

  .faq-item:hover {
    border-color: rgba(108, 71, 245, 0.4);
  }

  /* ── Question (summary) ──────────────────────────────── */
  .faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    cursor: pointer;
    list-style: none;
  }

  .faq-q::-webkit-details-marker {
    display: none;
  }

  .faq-q:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: -2px;
    border-radius: 1rem;
  }

  .faq-q-text {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--color-text-primary);
    margin: 0;
  }

  .faq-icon {
    flex-shrink: 0;
    width: 1.125rem;
    height: 1.125rem;
    color: var(--color-accent-fg);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .faq-icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }

  /* ── Answer ──────────────────────────────────────────── */
  .faq-a {
    padding: 0 1.25rem 1.25rem;
  }

  .faq-a p {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin: 0;
    max-width: 44rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-icon { transition: none; }
  }
</style>
