---
// macOS install commands — exact, do not alter.
const installCommands = [
  "brew tap MathieuDubart/cassette",
  "brew install --cask cassette",
];
// Both lines, newline-separated, no trailing newline — this is exactly what the
// copy button writes and what the code block shows.
const copyText = installCommands.join("\n");
---

<div class="mac-install fade-in" data-mac-install style="--d: 0.28s">
  <h2 class="mac-install-heading">Install on Mac</h2>
  <p class="mac-install-context">On macOS, install Cassette with Homebrew.</p>

  <div class="mac-install-card">
    <div class="mac-install-bar">
      <span class="mac-install-label">Terminal</span>
      <button type="button" class="mac-install-copy" aria-label="Copy install commands">
        <svg
          class="copy-icon icon-copy"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <svg
          class="copy-icon icon-check"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20 6 9 17l-5-5"></path>
        </svg>
        <span class="copy-label" aria-live="polite">Copy</span>
      </button>
    </div>
    <pre class="mac-install-code"><code>{copyText}</code></pre>
  </div>
</div>

<style>
  /* ── Wrapper ─────────────────────────────────────────── */
  .mac-install {
    width: 100%;
    max-width: 30rem;
    margin: 2.75rem auto 0;
  }

  .mac-install-heading {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    margin: 0 0 0.35rem;
  }

  .mac-install-context {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
    margin: 0 0 1.25rem;
  }

  /* ── Code card ───────────────────────────────────────── */
  .mac-install-card {
    border: 1px solid var(--color-border-subtle);
    border-radius: 0.875rem;
    background-color: var(--color-bg-secondary);
    box-shadow: var(--shadow-violet-sm);
    overflow: hidden;
    text-align: left;
  }

  .mac-install-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem 0.5rem 0.5rem 0.9rem;
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .mac-install-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--color-text-tertiary);
  }

  /* ── Copy button ─────────────────────────────────────── */
  .mac-install-copy {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.7rem;
    border-radius: 0.5rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    background: transparent;
    border: 1px solid var(--color-border-subtle);
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .mac-install-copy:hover {
    color: var(--color-text-primary);
    border-color: rgba(108, 71, 245, 0.4);
  }

  .mac-install-copy.is-copied {
    color: var(--color-accent-fg);
    border-color: var(--color-accent-primary);
  }

  .copy-icon {
    width: 0.875rem;
    height: 0.875rem;
    flex-shrink: 0;
  }

  .icon-check {
    display: none;
  }

  .is-copied .icon-copy {
    display: none;
  }

  .is-copied .icon-check {
    display: inline;
  }

  /* ── Commands ────────────────────────────────────────── */
  /* white-space:pre keeps each command on its own line; overflow-x scrolls
     cleanly on narrow screens rather than overflowing the section. */
  .mac-install-code {
    margin: 0;
    padding: 0.9rem 1rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--color-text-primary);
    white-space: pre;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .mac-install-code code {
    font-family: inherit;
  }

  /* ── Entrance (matches hero fade-up timing) ──────────── */
  .fade-in {
    animation: mac-install-in 0.6s ease-out var(--d, 0s) both;
  }

  @keyframes mac-install-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fade-in {
      animation: none;
    }
  }
</style>

<script>
  const initMacInstall = () => {
    const roots = document.querySelectorAll<HTMLElement>("[data-mac-install]");

    roots.forEach((root) => {
      if (root.dataset.bound === "true") return;
      root.dataset.bound = "true";

      const btn = root.querySelector<HTMLButtonElement>(".mac-install-copy");
      const code = root.querySelector<HTMLElement>(".mac-install-code");
      const label = root.querySelector<HTMLElement>(".copy-label");
      if (!btn || !code) return;

      // Source of truth for the copied text is the rendered code block, so what
      // gets copied is always exactly what's shown.
      const text = code.textContent ?? "";
      let resetTimer: ReturnType<typeof setTimeout> | undefined;

      const legacyCopy = (value: string): boolean => {
        try {
          const ta = document.createElement("textarea");
          ta.value = value;
          ta.setAttribute("readonly", "");
          ta.style.position = "fixed";
          ta.style.top = "-9999px";
          document.body.appendChild(ta);
          ta.select();
          const ok = document.execCommand("copy");
          document.body.removeChild(ta);
          return ok;
        } catch {
          return false;
        }
      };

      btn.addEventListener("click", async () => {
        let copied = false;
        try {
          if (navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(text);
            copied = true;
          } else {
            copied = legacyCopy(text);
          }
        } catch {
          copied = legacyCopy(text);
        }

        // If everything fails, the commands stay visible and selectable.
        if (!copied) return;

        btn.classList.add("is-copied");
        btn.setAttribute("aria-label", "Install commands copied");
        if (label) label.textContent = "Copied";

        clearTimeout(resetTimer);
        resetTimer = setTimeout(() => {
          btn.classList.remove("is-copied");
          btn.setAttribute("aria-label", "Copy install commands");
          if (label) label.textContent = "Copy";
        }, 2000);
      });
    });
  };

  initMacInstall();
  document.addEventListener("astro:page-load", initMacInstall);
</script>
