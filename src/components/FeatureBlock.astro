---
import PhoneMockup from "./PhoneMockup.astro";

interface Props {
  heading: string;
  body: string;
  screenshotPosition: "left" | "right";
  screenshotSrc?: string;
  screenshotAlt: string;
  index: number;
}

const { heading, body, screenshotPosition, screenshotSrc, screenshotAlt, index } =
  Astro.props;

const sideClass =
  screenshotPosition === "right" ? "is-screenshot-right" : "is-screenshot-left";
---

<article
  class={`feature-block ${sideClass}`}
  data-feature-index={index}
  aria-labelledby={`feature-${index}-heading`}
>
  <div class="feature-text">
    <h2 id={`feature-${index}-heading`} class="feature-heading">{heading}</h2>
    <p class="feature-body">{body}</p>
  </div>

  <div class="feature-screenshot">
    <PhoneMockup src={screenshotSrc} alt={screenshotAlt} />
  </div>
</article>

<style>
  .feature-block {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
    padding-block: 5rem;
  }

  @media (min-width: 768px) {
    .feature-block {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      padding-block: 8rem;
    }

    .feature-block.is-screenshot-left .feature-text {
      grid-column: 2;
      grid-row: 1;
    }

    .feature-block.is-screenshot-left .feature-screenshot {
      grid-column: 1;
      grid-row: 1;
    }
  }

  @media (min-width: 1024px) {
    .feature-block {
      gap: 6rem;
    }
  }

  .feature-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: 36rem;
  }

  .feature-heading {
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
    font-size: clamp(2.25rem, 5.5vw, 3.75rem);
    line-height: 1.05;
    margin: 0 0 1.5rem;
  }

  .feature-body {
    color: var(--color-text-secondary);
    font-size: 1.125rem;
    line-height: 1.65;
    max-width: 36rem;
    margin: 0;
  }

  @media (min-width: 768px) {
    .feature-body {
      font-size: 1.25rem;
    }
  }

  .feature-screenshot {
    display: flex;
    justify-content: center;
  }

  @media (min-width: 768px) {
    .feature-block.is-screenshot-left .feature-screenshot {
      justify-content: flex-start;
    }

    .feature-block.is-screenshot-right .feature-screenshot {
      justify-content: flex-end;
    }
  }

  /* Entrance animations */
  .feature-text,
  .feature-screenshot {
    opacity: 0;
    transition:
      opacity 600ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .feature-text {
    transform: translateY(20px);
  }

  .feature-screenshot {
    transition-duration: 700ms;
    transition-delay: 200ms;
  }

  .feature-block.is-screenshot-left .feature-screenshot {
    transform: translateX(-30px);
  }

  .feature-block.is-screenshot-right .feature-screenshot {
    transform: translateX(30px);
  }

  .feature-block.feature-visible .feature-text,
  .feature-block.feature-visible .feature-screenshot {
    opacity: 1;
    transform: none;
  }

  /* Stagger heading vs body inside the visible state */
  .feature-heading,
  .feature-body {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 600ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 600ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .feature-body {
    transition-delay: 100ms;
  }

  .feature-block.feature-visible .feature-heading,
  .feature-block.feature-visible .feature-body {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-text,
    .feature-screenshot,
    .feature-heading,
    .feature-body {
      opacity: 1;
      transform: none !important;
      transition: opacity 200ms ease-out;
    }
  }
</style>
