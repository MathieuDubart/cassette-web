---
interface Props {
  heading: string;
  body: string;
  screenshotPosition: "left" | "right";
  screenshotSrc?: string;
  screenshotAlt: string;
  index: number;
}

const { heading, body, screenshotPosition, screenshotSrc, screenshotAlt, index } = Astro.props;
const isLeft = screenshotPosition === "left";
---

<article
  class={`feature-block ${isLeft ? "is-left" : "is-right"}`}
  data-feature-index={index}
  aria-labelledby={`feature-${index}-heading`}
>
  <div class="feature-text">
    <p class="feature-label">{String(index + 1).padStart(2, "0")}</p>
    <h2 id={`feature-${index}-heading`} class="feature-heading">{heading}</h2>
    <p class="feature-body">{body}</p>
  </div>

  <div class="feature-media">
    <img
      src={screenshotSrc}
      alt={screenshotAlt}
      loading="lazy"
      decoding="async"
      class="feature-image"
    />
  </div>
</article>

<style>
  /* ── Layout ─────────────────────────────────────────── */
  .feature-block {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
    padding-block: 4rem;
  }

  .feature-block + .feature-block {
    border-top: 1px solid var(--color-border-subtle);
  }

  @media (min-width: 768px) {
    .feature-block {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      padding-block: 6rem;
    }

    .feature-block.is-left .feature-text  { grid-column: 2; grid-row: 1; }
    .feature-block.is-left .feature-media { grid-column: 1; grid-row: 1; }
  }

  @media (min-width: 1024px) {
    .feature-block { gap: 5rem; }
  }

  .feature-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .feature-media {
    display: flex;
    justify-content: center;
  }

  @media (min-width: 768px) {
    .feature-block.is-left  .feature-media { justify-content: flex-start; }
    .feature-block.is-right .feature-media { justify-content: flex-end; }
  }

  /* ── Image ───────────────────────────────────────────── */
  .feature-image {
    display: block;
    width: 100%;
    max-width: 300px;
    border-radius: 2.5rem;
    filter:
      drop-shadow(0 0 44px rgba(108, 71, 245, 0.26))
      drop-shadow(0 16px 36px rgba(15, 13, 26, 0.42));
  }

  @media (min-width: 768px)  { .feature-image { max-width: 320px; } }
  @media (min-width: 1024px) { .feature-image { max-width: 360px; } }

  /* ── Text elements ───────────────────────────────────── */
  .feature-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent-fg);
    margin: 0 0 1.25rem;
  }

  .feature-heading {
    font-size: clamp(1.875rem, 4.5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.08;
    color: var(--color-text-primary);
    margin: 0 0 1.25rem;
  }

  .feature-body {
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin: 0;
  }

  @media (min-width: 768px) {
    .feature-body { font-size: 1.125rem; }
  }

  /* ── Reveal ──────────────────────────────────────────── */
  .feature-label,
  .feature-heading,
  .feature-body,
  .feature-media {
    opacity: 0;
    transform: translateY(12px);
  }

  .feature-label   { transition: opacity 0.5s ease-out,        transform 0.5s ease-out; }
  .feature-heading { transition: opacity 0.5s ease-out  60ms,  transform 0.5s ease-out  60ms; }
  .feature-body    { transition: opacity 0.5s ease-out 110ms,  transform 0.5s ease-out 110ms; }
  .feature-media   { transition: opacity 0.5s ease-out  30ms,  transform 0.5s ease-out  30ms; }

  .feature-block.feature-visible .feature-label,
  .feature-block.feature-visible .feature-heading,
  .feature-block.feature-visible .feature-body,
  .feature-block.feature-visible .feature-media {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-label,
    .feature-heading,
    .feature-body,
    .feature-media {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
