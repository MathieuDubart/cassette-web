---
interface Props {
  heading: string;
  body: string;
  screenshotPosition: "left" | "right";
  screenshotSrc?: string;
  screenshotAlt: string;
  index: number;
  macHeading?: string;
  macBody?: string;
  macScreenshotSrc?: string;
  macScreenshotAlt?: string;
}

const {
  heading, body, screenshotPosition, screenshotSrc, screenshotAlt, index,
  macHeading, macBody, macScreenshotSrc, macScreenshotAlt,
} = Astro.props;
const isLeft = screenshotPosition === "left";
---

<article
  class={`feature-block ${isLeft ? "is-left" : "is-right"}`}
  data-feature-index={index}
  aria-labelledby={`feature-${index}-heading`}
>
  <div class="feature-text">
    <p class="feature-label">{String(index + 1).padStart(2, "0")}</p>

    <h2
      id={`feature-${index}-heading`}
      class={`feature-heading${macHeading ? " heading-has-variants" : ""}`}
    >
      {macHeading ? (
        <>
          <span class="platform-variant variant-iphone">{heading}</span>
          <span class="platform-variant variant-mac">{macHeading}</span>
        </>
      ) : heading}
    </h2>

    <p class={`feature-body${macBody ? " body-has-variants" : ""}`}>
      {macBody ? (
        <>
          <span class="platform-variant variant-iphone">{body}</span>
          <span class="platform-variant variant-mac">{macBody}</span>
        </>
      ) : body}
    </p>
  </div>

  <div class={`feature-media${macScreenshotSrc ? " media-has-variants" : ""}`}>
    {macScreenshotSrc ? (
      <>
        <img
          src={screenshotSrc}
          alt={screenshotAlt}
          loading="lazy"
          decoding="async"
          class="feature-image platform-variant variant-iphone"
        />
        <img
          src={macScreenshotSrc}
          alt={macScreenshotAlt ?? ""}
          loading="lazy"
          decoding="async"
          class="feature-image platform-variant variant-mac mac-image"
        />
      </>
    ) : (
      <img
        src={screenshotSrc}
        alt={screenshotAlt}
        loading="lazy"
        decoding="async"
        class="feature-image"
      />
    )}
  </div>
</article>

<style>
  /* ── Layout ─────────────────────────────────────────── */
  .feature-block {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
    padding-block: 5rem;   /* 80px mobile — agressive whitespace */
  }

  .feature-block + .feature-block {
    border-top: 1px solid var(--color-border-subtle);
  }

  @media (min-width: 768px) {
    .feature-block {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      padding-block: 7.5rem;   /* 120px desktop */
    }

    .feature-block.is-left .feature-text  { grid-column: 2; grid-row: 1; }
    .feature-block.is-left .feature-media { grid-column: 1; grid-row: 1; }
  }

  @media (min-width: 1024px) {
    .feature-block { gap: 5rem; }
  }

  .feature-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .feature-media {
    display: flex;
    justify-content: center;
  }

  @media (min-width: 768px) {
    .feature-block.is-left  .feature-media { justify-content: center; }
    .feature-block.is-right .feature-media { justify-content: center; }
  }

  /* When both platform images exist: switch to grid so they share the same cell */
  .media-has-variants {
    display: grid;
    justify-items: center;
    align-items: center;
  }

  /* ── Image ───────────────────────────────────────────── */
  /* box-shadow instead of filter: drop-shadow — better perf on rectangular JPEGs */
  .feature-image {
    display: block;
    width: 100%;
    max-width: 300px;
    border-radius: 2.5rem;
    filter:
      drop-shadow(0 0 56px rgba(108, 71, 245, 0.35))
      drop-shadow(0 32px 60px rgba(0, 0, 0, 0.45));
  }

  /* Mac screenshots are windows, not phone bezels */
  .mac-image {
    border-radius: 0.75rem;
    max-width: 440px;
  }

  @media (min-width: 768px)  {
    .feature-image { max-width: 320px; }
    .mac-image { max-width: 520px; }
  }
  @media (min-width: 1024px) {
    .feature-image { max-width: 360px; }
    .mac-image { max-width: 600px; }
  }

  /* ── Text elements ───────────────────────────────────── */
  .feature-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent-fg);
    margin: 0 0 1.25rem;
  }

  /* clamp(32px, 5vw, 56px) per spec */
  .feature-heading {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--color-text-primary);
    margin: 0 0 1.25rem;
  }

  .feature-body {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 30rem;   /* ~480px — keeps line length comfortable */
    margin: 0;
  }

  @media (min-width: 768px) {
    .feature-body { font-size: 1.125rem; }
  }

  /* ── Platform-variant crossfade ─────────────────────── */
  /* Grid stacking: both spans share one cell, container height = max of both.
     No layout shift when switching — the taller variant always reserves space. */
  .heading-has-variants,
  .body-has-variants {
    display: grid;
  }

  .platform-variant {
    grid-area: 1 / 1;
  }

  /* iPhone = default (no data-platform attribute on <html>) */
  .variant-iphone {
    opacity: 1;
    visibility: visible;
    /* Immediate visibility, then fade out when leaving */
    transition: opacity 0.22s ease, visibility 0s linear 0s;
  }

  .variant-mac {
    opacity: 0;
    visibility: hidden;
    /* Fade out first, then snap to hidden so it leaves the a11y tree */
    transition: opacity 0.22s ease, visibility 0s linear 0.22s;
  }

  /* Mac platform active — driven by html[data-platform="mac"] */
  :global([data-platform="mac"]) .variant-iphone {
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.22s ease, visibility 0s linear 0.22s;
  }

  :global([data-platform="mac"]) .variant-mac {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.22s ease, visibility 0s linear 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .variant-iphone,
    .variant-mac {
      transition: none !important;
    }
  }

  /* ── Reveal ──────────────────────────────────────────── */
  .feature-label,
  .feature-heading,
  .feature-body { opacity: 0; transform: translateY(32px); }

  /* Media lifts 48px — heavier, matches spec's device-mockup treatment */
  .feature-media { opacity: 0; transform: translateY(48px); }

  .feature-label   { transition: opacity 600ms cubic-bezier(0.16, 1, 0.3, 1),        transform 600ms cubic-bezier(0.16, 1, 0.3, 1); }
  .feature-heading { transition: opacity 600ms cubic-bezier(0.16, 1, 0.3, 1)  60ms,  transform 600ms cubic-bezier(0.16, 1, 0.3, 1)  60ms; }
  .feature-body    { transition: opacity 600ms cubic-bezier(0.16, 1, 0.3, 1) 110ms,  transform 600ms cubic-bezier(0.16, 1, 0.3, 1) 110ms; }
  .feature-media   { transition: opacity 800ms cubic-bezier(0.16, 1, 0.3, 1)  30ms,  transform 800ms cubic-bezier(0.16, 1, 0.3, 1)  30ms; }

  .feature-block.feature-visible .feature-label,
  .feature-block.feature-visible .feature-heading,
  .feature-block.feature-visible .feature-body,
  .feature-block.feature-visible .feature-media {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-label,
    .feature-heading,
    .feature-body,
    .feature-media {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  @media (prefers-color-scheme: light) {
    .feature-image {
      filter:
        drop-shadow(0 0 56px rgba(108, 71, 245, 0.18))
        drop-shadow(0 32px 60px rgba(0, 0, 0, 0.12));
    }
  }
</style>
