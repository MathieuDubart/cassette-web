---
---

<section class="survey-section" aria-labelledby="survey-heading">
  <div class="survey-container">
    <div class="survey-header reveal" id="survey-heading-wrapper">
      <h2 id="survey-heading" class="survey-title">Shape what's next</h2>
      <p class="survey-subtitle">5 minutes · Anonymous · Helps prioritize what gets built</p>
    </div>

    <div class="survey-embed reveal reveal-delay-200">
      <iframe
        data-tally-src="https://tally.so/embed/eq0LRq?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1"
        loading="lazy"
        width="100%"
        height="350px"
        frameborder="0"
        marginheight="0"
        marginwidth="0"
        title="Cassette Feedback"
      ></iframe>
    </div>
  </div>
</section>

<script>
  var d = document,
    w = "https://tally.so/widgets/embed.js",
    v = function () {
      "undefined" != typeof Tally
        ? Tally.loadEmbeds()
        : d
            .querySelectorAll("[data-tally-src]:not([src])")
            .forEach(function (e) {
              e.src = e.dataset.tallySrc;
            });
    };
  if ("undefined" != typeof Tally) v();
  else if (d.querySelector('script[src="' + w + '"]') == null) {
    var s = d.createElement("script");
    s.src = w;
    s.onload = v;
    s.onerror = v;
    d.body.appendChild(s);
  }
</script>

<style>
  .survey-section {
    padding-block: 6rem;
    border-top: 1px solid var(--color-border-subtle);
  }

  .survey-container {
    width: 100%;
    max-width: 64rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  @media (min-width: 768px) {
    .survey-container {
      padding-inline: 3rem;
    }
  }

  .survey-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .survey-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
  }

  .survey-subtitle {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .survey-embed {
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid var(--color-border-subtle);
    background-color: var(--color-bg-secondary);
  }

  .survey-embed iframe {
    display: block;
  }
</style>
