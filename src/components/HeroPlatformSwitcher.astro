---
interface Props {
  iphoneScreenshot: string;
  iphoneAlt: string;
  macScreenshot: string;
  macAlt: string;
}

const { iphoneScreenshot, iphoneAlt, macScreenshot, macAlt } = Astro.props;
---

<div class="platform-switcher" data-switcher>
  <!-- Platform toggle pills -->
  <div class="switcher-pills" role="group" aria-label="Switch platform preview">
    <button
      class="switcher-pill"
      data-platform="iphone"
      aria-pressed="true"
      type="button"
    >
      <svg class="pill-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17 1.01L7 1C5.9 1 5 1.9 5 3v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-1.99-2-1.99zM17 19H7V5h10v14z"/>
      </svg>
      iPhone
    </button>
    <button
      class="switcher-pill"
      data-platform="mac"
      aria-pressed="false"
      type="button"
    >
      <svg class="pill-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M21 2H3c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h7l-2 3v1h8v-1l-2-3h7c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 12H3V4h18v10z"/>
      </svg>
      Mac
    </button>
  </div>

  <!-- Both images share the same grid cell — zero layout shift on switch -->
  <div class="mockup-stack">
    <img
      src={iphoneScreenshot}
      alt={iphoneAlt}
      data-mockup="iphone"
      class="mockup-img iphone-frame is-active"
      loading="eager"
      decoding="sync"
    />
    <!-- Replace /images/header_mac.jpeg with the real Mac App screenshot when available -->
    <img
      src={macScreenshot}
      alt={macAlt}
      data-mockup="mac"
      class="mockup-img mac-frame"
      loading="lazy"
      decoding="async"
    />
  </div>
</div>

<style>
  .platform-switcher {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  /* ── Pill toggle group ──────────────────────────────── */
  .switcher-pills {
    display: inline-flex;
    padding: 0.25rem;
    border-radius: 9999px;
    background-color: rgba(34, 30, 56, 0.9);
    border: 1px solid rgba(108, 71, 245, 0.28);
    gap: 0.125rem;
    backdrop-filter: blur(8px);
  }

  .switcher-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 1rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    border: none;
    cursor: pointer;
    background: transparent;
    color: var(--color-text-secondary);
    font-family: inherit;
    -webkit-appearance: none;
    appearance: none;
    transition: background-color 0.18s ease, color 0.18s ease, box-shadow 0.18s ease;
  }

  .switcher-pill[aria-pressed="true"] {
    background-color: var(--color-accent-primary);
    color: #fff;
    box-shadow: 0 2px 10px rgba(108, 71, 245, 0.4);
  }

  .switcher-pill:focus-visible {
    outline: 2px solid var(--color-accent-primary);
    outline-offset: 2px;
    border-radius: 9999px;
  }

  .pill-icon {
    width: 0.875rem;
    height: 0.875rem;
    flex-shrink: 0;
  }

  /* ── Stacked mockups ───────────────────────────────── */
  /* Grid stacking keeps both images in the same cell:
     container height = max of both → no layout shift on switch */
  .mockup-stack {
    display: grid;
    justify-items: center;
  }

  .mockup-img {
    grid-area: 1 / 1;
    display: block;
    width: 100%;
    max-width: 300px;
    filter:
      drop-shadow(0 0 56px rgba(108, 71, 245, 0.48))
      drop-shadow(0 20px 44px rgba(15, 13, 26, 0.42));
    opacity: 0;
    pointer-events: none;
    /* Transition controlled by JS via data-animating to avoid flash on load */
  }

  [data-switcher]:not([data-animating="false"]) .mockup-img {
    transition: opacity 0.2s ease;
  }

  .mockup-img.is-active {
    opacity: 1;
    pointer-events: auto;
  }

  /* iPhone mockup: phone bezel radius */
  .iphone-frame { border-radius: 2.625rem; }

  /* Mac mockup: window corner radius */
  .mac-frame {
    border-radius: 0.75rem;
    max-width: 640px;
  }

  @media (min-width: 768px) {
    .mockup-img { max-width: 340px; }
    .mac-frame  { max-width: 820px; }
  }

  @media (min-width: 1024px) {
    .mockup-img { max-width: 390px; }
    .mac-frame  { max-width: 960px; }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-switcher] .mockup-img { transition: none; }
    /* Still show the correct active image without animation */
    .mockup-img:not(.is-active) { display: none; }
  }

  @media (prefers-color-scheme: light) {
    .switcher-pills {
      background-color: rgba(255, 255, 255, 0.9);
      border-color: rgba(108, 71, 245, 0.2);
    }

    .mockup-img {
      filter:
        drop-shadow(0 0 56px rgba(108, 71, 245, 0.22))
        drop-shadow(0 20px 44px rgba(0, 0, 0, 0.12));
    }
  }
</style>

<script>
  const initPlatformSwitcher = () => {
    const switchers = document.querySelectorAll<HTMLElement>("[data-switcher]");

    switchers.forEach((switcher) => {
      const pills = switcher.querySelectorAll<HTMLButtonElement>("[data-platform]");
      const mockups = switcher.querySelectorAll<HTMLImageElement>("[data-mockup]");

      // Apply initial platform instantly (no crossfade flash on page load)
      const saved = sessionStorage.getItem("cassette-platform") ?? "iphone";
      switcher.dataset.animating = "false";
      applyPlatform(saved);
      requestAnimationFrame(() => delete switcher.dataset.animating);

      pills.forEach((pill) => {
        pill.addEventListener("click", () => {
          const platform = pill.dataset.platform!;
          sessionStorage.setItem("cassette-platform", platform);
          applyPlatform(platform);
        });
      });

      function applyPlatform(platform: string) {
        // Drive all platform-aware components via a single HTML attribute
        if (platform === "mac") {
          document.documentElement.dataset.platform = "mac";
        } else {
          delete document.documentElement.dataset.platform;
        }

        pills.forEach((p) => {
          p.setAttribute("aria-pressed", String(p.dataset.platform === platform));
        });
        mockups.forEach((m) => {
          m.classList.toggle("is-active", m.dataset.mockup === platform);
        });
      }
    });
  };

  initPlatformSwitcher();
  document.addEventListener("astro:page-load", initPlatformSwitcher);
</script>
