---
import PhoneMockup from "./PhoneMockup.astro";

const githubUrl = "https://github.com/MathieuDubart/Cassette";
const logoUrl = `${import.meta.env.BASE_URL}/images/cassette-wow-loop.svg`.replace(/\/+/g, "/");
const heroScreenshot = `${import.meta.env.BASE_URL}/images/header.jpeg`.replace(/\/+/g, "/");
---

<section class="hero-section relative isolate min-h-screen overflow-hidden">

  <!-- ── Background atmosphere ────────────────────────────── -->
  <div class="pointer-events-none absolute inset-0 -z-20" aria-hidden="true">
    <!-- Dot grid -->
    <div class="hero-grid absolute inset-0"></div>
    <!-- Drifting orbs -->
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div class="orb orb-3"></div>
    <!-- Central radial halo -->
    <div
      class="hero-halo absolute inset-0"
      style="background: radial-gradient(ellipse 65% 50% at 55% 58%, rgba(108,71,245,0.18) 0%, transparent 70%);"
    ></div>
    <!-- Aurora streak -->
    <div class="aurora"></div>
  </div>

  <!-- Grain overlay -->
  <div class="hero-grain pointer-events-none absolute inset-0 z-10" aria-hidden="true"></div>

  <!-- ── Navigation ───────────────────────────────────────── -->
  <header class="relative z-20 mx-auto flex w-full max-w-7xl items-center justify-between px-6 pt-6 sm:px-8 sm:pt-8">
    <a
      href="#"
      class="group inline-flex items-center gap-2 text-base font-semibold tracking-tight text-text-primary"
      aria-label="Cassette home"
    >
      <img
        src={logoUrl}
        alt=""
        width="32"
        height="32"
        loading="eager"
        decoding="sync"
        class="h-8 w-8 rounded-lg"
      />
      <span>Cassette</span>
    </a>

    <nav class="flex items-center gap-2 sm:gap-1" aria-label="Primary">
      <a
        href="#features"
        class="rounded-full px-3 py-1.5 text-sm font-medium text-text-secondary transition-colors hover:text-text-primary"
        >Features</a
      >
      <a
        href={githubUrl}
        rel="noopener"
        target="_blank"
        class="rounded-full px-3 py-1.5 text-sm font-medium text-text-secondary transition-colors hover:text-text-primary"
        >GitHub</a
      >
    </nav>
  </header>

  <!-- ── Content + Phone ──────────────────────────────────── -->
  <div class="relative z-10 mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-12 px-6 pt-16 pb-24 sm:px-8 sm:pt-24 lg:grid-cols-12 lg:gap-16 lg:pt-28 lg:pb-32">

    <!-- Text column -->
    <div class="lg:col-span-7">
      <p class="hero-badge inline-flex items-center gap-2 rounded-full border border-accent-primary/25 bg-accent-soft px-3 py-1 text-xs font-medium tracking-wide text-accent-fg uppercase">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent-primary"></span>
        Now available on TestFlight
      </p>

      <h1
        class="hero-title mt-6 font-bold text-text-primary"
        style="font-size: clamp(2.75rem, 7.5vw, 5.75rem); line-height: 1.02; letter-spacing: -0.035em;"
      >
        Your music,<br />your server,<br /><span class="shimmer-text">your app.</span>
      </h1>

      <p
        class="hero-subtitle mt-7 max-w-xl text-lg text-text-secondary sm:text-xl"
        style="line-height: 1.55;"
      >
        Cassette is a native iOS and macOS client for Subsonic and OpenSubsonic. Beautiful, fast,
        and built for people who self-host.
      </p>

      <div class="hero-cta mt-10 flex flex-wrap items-center gap-3">
        <a
          href="https://testflight.apple.com/join/pxCpfpxF"
          rel="noopener"
          target="_blank"
          class="group inline-flex items-center gap-2 rounded-full bg-accent-primary px-6 py-3 text-base font-medium text-white transition-colors duration-150 hover:bg-accent-hover active:scale-[0.99]"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
          </svg>
          TestFlight
        </a>
        <a
          href={githubUrl}
          rel="noopener"
          target="_blank"
          class="group inline-flex items-center gap-2 rounded-full border border-white/15 px-6 py-3 text-base font-medium text-text-primary transition-colors duration-150 hover:border-white/30 active:scale-[0.99]"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.082-.73.082-.73 1.205.085 1.838 1.236 1.838 1.236 1.07 1.835 2.81 1.305 3.495.998.108-.776.418-1.305.762-1.605-2.665-.305-5.467-1.332-5.467-5.93 0-1.31.467-2.38 1.236-3.22-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.3 1.23a11.5 11.5 0 0 1 3.003-.404c1.02.005 2.047.138 3.005.404 2.29-1.552 3.297-1.23 3.297-1.23.654 1.652.243 2.873.12 3.176.77.84 1.235 1.91 1.235 3.22 0 4.61-2.807 5.62-5.48 5.92.43.37.82 1.103.82 2.222 0 1.606-.014 2.898-.014 3.293 0 .322.216.694.825.576C20.565 22.092 24 17.594 24 12.297c0-6.627-5.373-12-12-12"
            ></path>
          </svg>
          View on GitHub
        </a>
      </div>
    </div>

    <!-- Phone column -->
    <div class="hero-mockup-col lg:col-span-5">
      <!-- Float wrapper — CSS handles the gentle levitation -->
      <div class="phone-float-wrap mx-auto max-w-[320px] lg:max-w-none">
        <!-- 3D stage — JS injects rotateX/Y here -->
        <div class="phone-3d-stage" id="hero3dStage">
          <div class="phone-3d-inner" id="hero3dInner">
            <!-- Ambient glow (also shifts with tilt) -->
            <div class="phone-glow" id="heroGlow" aria-hidden="true"></div>
            <!-- Pulsing ring around glow -->
            <div class="phone-ring" aria-hidden="true"></div>
            <div class="phone-ring phone-ring--delayed" aria-hidden="true"></div>

            <PhoneMockup src={heroScreenshot} alt="Cassette app on iPhone — home screen" />

            <!-- Specular highlight — updated by mouse via JS -->
            <div class="phone-shine" id="heroShine" aria-hidden="true"></div>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- ── Styles ─────────────────────────────────────────────── -->
<style>
  /* Entrance: halo + grid */
  .hero-halo  { animation: hero-halo-in 1.4s ease-out both; }
  .hero-grid  {
    background-image: radial-gradient(circle, rgba(255,255,255,0.045) 1px, transparent 1px);
    background-size: 36px 36px;
    animation: hero-halo-in 2s ease-out 0.4s both;
  }

  /* ── Orbs ───────────────────────────────────────────────── */
  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    will-change: transform;
  }

  .orb-1 {
    width: clamp(320px, 50vw, 640px);
    height: clamp(260px, 40vw, 520px);
    top: -8%;
    right: -8%;
    background: radial-gradient(circle at 35% 45%, rgba(108,71,245,0.38) 0%, transparent 68%);
    animation:
      hero-halo-in 1.8s ease-out both,
      orb-drift-1 24s ease-in-out 1.8s infinite;
  }

  .orb-2 {
    width: clamp(260px, 40vw, 500px);
    height: clamp(260px, 40vw, 500px);
    bottom: 2%;
    left: -6%;
    background: radial-gradient(circle at 60% 50%, rgba(128,96,247,0.28) 0%, transparent 68%);
    animation:
      hero-halo-in 1.8s ease-out 0.3s both,
      orb-drift-2 30s ease-in-out 2.1s infinite;
  }

  .orb-3 {
    width: clamp(180px, 25vw, 320px);
    height: clamp(180px, 25vw, 320px);
    top: 38%;
    left: 28%;
    filter: blur(70px);
    background: radial-gradient(circle, rgba(160,120,250,0.18) 0%, transparent 68%);
    animation:
      hero-halo-in 2s ease-out 0.6s both,
      orb-drift-3 19s ease-in-out 2.6s infinite alternate;
  }

  @keyframes orb-drift-1 {
    0%   { transform: translate(0,   0)   scale(1);    }
    20%  { transform: translate(-28px, 22px) scale(1.04); }
    45%  { transform: translate(18px, -16px) scale(0.97); }
    70%  { transform: translate(-12px, 30px) scale(1.02); }
    100% { transform: translate(0,   0)   scale(1);    }
  }

  @keyframes orb-drift-2 {
    0%   { transform: translate(0,   0)   scale(1);    }
    30%  { transform: translate(35px, -28px) scale(1.06); }
    65%  { transform: translate(-22px, 12px) scale(0.95); }
    100% { transform: translate(0,   0)   scale(1);    }
  }

  @keyframes orb-drift-3 {
    from { transform: translate(0, 0)     scale(1);   }
    to   { transform: translate(22px,-32px) scale(1.1); }
  }

  /* ── Aurora streak ──────────────────────────────────────── */
  .aurora {
    position: absolute;
    width: 130%;
    height: 1px;
    left: -15%;
    top: 32%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(108,71,245,0.0) 10%,
      rgba(128,96,247,0.55) 45%,
      rgba(192,160,255,0.7) 50%,
      rgba(128,96,247,0.55) 55%,
      rgba(108,71,245,0.0) 90%,
      transparent 100%
    );
    filter: blur(6px);
    transform: rotate(-6deg);
    animation: aurora-sweep 10s ease-in-out 3s infinite;
    opacity: 0;
  }

  @keyframes aurora-sweep {
    0%   { opacity: 0; transform: rotate(-6deg) translateX(-3%); }
    15%  { opacity: 1; }
    50%  { transform: rotate(-5deg) translateX(3%); }
    85%  { opacity: 1; }
    100% { opacity: 0; transform: rotate(-6deg) translateX(-3%); }
  }

  /* ── Grain ──────────────────────────────────────────────── */
  .hero-grain {
    background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='256' height='256'><filter id='g'><feTurbulence type='fractalNoise' baseFrequency='0.88' numOctaves='4' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='256' height='256' filter='url(%23g)' opacity='1'/></svg>");
    background-size: 220px 220px;
    opacity: 0.038;
    mix-blend-mode: overlay;
  }

  /* ── Text shimmer ───────────────────────────────────────── */
  .shimmer-text {
    background: linear-gradient(
      108deg,
      #8060F7 0%,
      #8060F7 28%,
      #C4AEFF 44%,
      #EBE0FF 50%,
      #C4AEFF 56%,
      #8060F7 72%,
      #8060F7 100%
    );
    background-size: 280% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: text-shimmer 6s linear 2.8s infinite;
  }

  @keyframes text-shimmer {
    0%   { background-position: 100% center; }
    100% { background-position: -180% center; }
  }

  /* ── Entrance animations ────────────────────────────────── */
  .hero-badge {
    animation: hero-slide-up 1s cubic-bezier(0.22, 1, 0.36, 1) 0.2s both;
  }
  .hero-title {
    animation: hero-slide-up 1s cubic-bezier(0.22, 1, 0.36, 1) 0.35s both;
  }
  .hero-subtitle {
    animation: hero-slide-up 1s cubic-bezier(0.22, 1, 0.36, 1) 0.55s both;
  }
  .hero-cta {
    animation: hero-pop-in 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.75s both;
  }
  .hero-mockup-col {
    animation: hero-mockup-up 1.1s cubic-bezier(0.22, 1, 0.36, 1) 0.5s both;
  }

  /* ── Phone 3D + float ───────────────────────────────────── */
  .phone-float-wrap {
    animation: phone-float 5s ease-in-out 1.6s infinite;
  }

  @keyframes phone-float {
    0%, 100% { transform: translateY(0px); }
    50%       { transform: translateY(-14px); }
  }

  .phone-3d-stage {
    perspective: 1100px;
    perspective-origin: 50% 38%;
  }

  .phone-3d-inner {
    position: relative;
    transform-style: preserve-3d;
    will-change: transform;
  }

  /* Ambient glow behind phone */
  .phone-glow {
    position: absolute;
    inset: -30% -20%;
    background: radial-gradient(circle at 50% 58%, rgba(108,71,245,0.55) 0%, transparent 62%);
    filter: blur(48px);
    z-index: -1;
    will-change: transform;
    pointer-events: none;
  }

  /* Pulsing rings */
  .phone-ring {
    position: absolute;
    inset: -18% -12%;
    border-radius: 50%;
    border: 1px solid rgba(108,71,245,0.18);
    pointer-events: none;
    z-index: -1;
    animation: ring-pulse 4s ease-out 1.8s infinite;
  }

  .phone-ring--delayed {
    animation-delay: 2.8s;
  }

  @keyframes ring-pulse {
    0%   { transform: scale(0.88); opacity: 0.6; }
    100% { transform: scale(1.45); opacity: 0; }
  }

  /* Specular highlight (updated via JS) */
  .phone-shine {
    position: absolute;
    inset: 0;
    border-radius: 15%;
    pointer-events: none;
    z-index: 5;
    mix-blend-mode: plus-lighter;
    transition: background 80ms linear;
  }

  @media (prefers-reduced-motion: reduce) {
    .orb-1, .orb-2, .orb-3,
    .phone-float-wrap,
    .aurora,
    .phone-ring,
    .phone-ring--delayed,
    .shimmer-text {
      animation: none !important;
    }
    .shimmer-text {
      color: #8060F7;
      background: none;
      -webkit-background-clip: unset;
      background-clip: unset;
    }
  }
</style>

<!-- ── 3D tilt script ──────────────────────────────────────── -->
<script>
  const stage  = document.getElementById('hero3dStage') as HTMLElement | null;
  const inner  = document.getElementById('hero3dInner') as HTMLElement | null;
  const glow   = document.getElementById('heroGlow')   as HTMLElement | null;
  const shine  = document.getElementById('heroShine')  as HTMLElement | null;

  /* Only run on pointer devices */
  const hasPointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  if (!hasPointer || !stage || !inner) {
    // no-op on touch / no-pointer devices
  } else {
    let tX = 0, tY = 0, cX = 0, cY = 0;

    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

    window.addEventListener('mousemove', (e: MouseEvent) => {
      const r   = stage.getBoundingClientRect();
      const cx  = r.left + r.width  / 2;
      const cy  = r.top  + r.height / 2;
      /* Normalise to roughly [-1, 1] relative to viewport half */
      tX = (e.clientY - cy) / (window.innerHeight * 0.5);
      tY = (e.clientX - cx) / (window.innerWidth  * 0.5);

      /* Specular highlight — tracks mouse within phone bounds */
      if (shine) {
        const sx = Math.max(0, Math.min(100, ((e.clientX - r.left) / r.width)  * 100));
        const sy = Math.max(0, Math.min(100, ((e.clientY - r.top)  / r.height) * 100));
        shine.style.background =
          `radial-gradient(circle at ${sx.toFixed(1)}% ${sy.toFixed(1)}%, rgba(255,255,255,0.09) 0%, transparent 52%)`;
      }
    }, { passive: true });

    /* Reset when cursor leaves the document */
    document.addEventListener('mouseleave', () => { tX = 0; tY = 0; });

    /* Smooth lerp loop */
    (function tick() {
      cX = lerp(cX, tX, 0.065);
      cY = lerp(cY, tY, 0.065);

      const rX = (-cX * 13).toFixed(3);
      const rY = (cY  * 17).toFixed(3);

      inner.style.transform =
        `perspective(1100px) rotateX(${rX}deg) rotateY(${rY}deg)`;

      /* Parallax on ambient glow — shifts opposite to tilt for depth */
      if (glow) {
        glow.style.transform =
          `translateX(${(cY * 14).toFixed(2)}px) translateY(${(cX * 9).toFixed(2)}px)`;
      }

      requestAnimationFrame(tick);
    })();
  }
</script>
