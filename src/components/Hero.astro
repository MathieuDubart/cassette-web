---
import PhoneMockup from "./PhoneMockup.astro";

const githubUrl = "https://github.com/MathieuDubart/Cassette";
const logoUrl = `${import.meta.env.BASE_URL}/images/cassette-icon-1024.png`.replace(/\/+/g, "/");
const heroScreenshot = `${import.meta.env.BASE_URL}/images/header.jpeg`.replace(/\/+/g, "/");
---

<section class="relative isolate min-h-screen overflow-hidden">

  <!-- ── Atmospheric backdrop ──────────────────────────── -->
  <div class="pointer-events-none absolute inset-0 -z-20" aria-hidden="true">
    <div class="hero-grid absolute inset-0"></div>
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>
    <div
      class="hero-halo absolute inset-0"
      style="background: radial-gradient(ellipse 65% 50% at 55% 58%, rgba(108,71,245,0.16) 0%, transparent 70%);"
    ></div>
  </div>
  <div class="hero-grain pointer-events-none absolute inset-0 z-10" aria-hidden="true"></div>

  <!-- ── Navigation ────────────────────────────────────── -->
  <header class="relative z-20 mx-auto flex w-full max-w-7xl items-center justify-between px-6 pt-6 sm:px-8 sm:pt-8">
    <a
      href="#"
      class="group inline-flex items-center gap-2 text-base font-semibold tracking-tight text-text-primary"
      aria-label="Cassette home"
    >
      <img
        src={logoUrl}
        alt=""
        width="32"
        height="32"
        loading="eager"
        decoding="sync"
        class="h-8 w-8 rounded-lg"
      />
      <span>Cassette</span>
    </a>

    <nav class="flex items-center gap-2 sm:gap-1" aria-label="Primary">
      <a
        href="#features"
        class="rounded-full px-3 py-1.5 text-sm font-medium text-text-secondary transition-colors hover:text-text-primary"
        >Features</a
      >
      <a
        href={githubUrl}
        rel="noopener"
        target="_blank"
        class="rounded-full px-3 py-1.5 text-sm font-medium text-text-secondary transition-colors hover:text-text-primary"
        >GitHub</a
      >
    </nav>
  </header>

  <!-- ── Content grid ───────────────────────────────────── -->
  <div class="relative z-10 mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-12 px-6 pt-16 pb-24 sm:px-8 sm:pt-24 lg:grid-cols-12 lg:gap-16 lg:pt-28 lg:pb-32">

    <!-- Text column -->
    <div class="lg:col-span-7">

      <p class="hero-badge inline-flex items-center gap-2 rounded-full border border-accent-primary/25 bg-accent-soft px-3 py-1 text-xs font-medium tracking-wide text-accent-fg uppercase">
        <span class="inline-block h-1.5 w-1.5 rounded-full bg-accent-primary"></span>
        Now available on TestFlight
      </p>

      <!-- Line-mask reveal: each line slides up from its overflow-hidden wrapper -->
      <h1
        class="mt-6 font-bold text-text-primary"
        style="font-size: clamp(2.75rem, 7.5vw, 5.75rem); line-height: 1.08; letter-spacing: -0.035em;"
      >
        <span class="lm-wrap"><span class="lm-text" style="--d: 0.22s">Your music,</span></span>
        <span class="lm-wrap"><span class="lm-text" style="--d: 0.38s">your server,</span></span>
        <span class="lm-wrap"><span class="lm-text" style="--d: 0.54s">
          <span class="shimmer-text">your app.</span>
        </span></span>
      </h1>

      <p
        class="hero-subtitle mt-7 max-w-xl text-lg text-text-secondary sm:text-xl"
        style="line-height: 1.55;"
      >
        Cassette is a native iOS and macOS client for Subsonic and OpenSubsonic. Beautiful, fast,
        and built for people who self-host.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a
          href="https://testflight.apple.com/join/pxCpfpxF"
          rel="noopener"
          target="_blank"
          class="hero-btn inline-flex items-center gap-2 rounded-full bg-accent-primary px-6 py-3 text-base font-medium text-white transition-colors duration-150 hover:bg-accent-hover active:scale-[0.99]"
          style="animation-delay: 0.8s"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
          </svg>
          TestFlight
        </a>
        <a
          href={githubUrl}
          rel="noopener"
          target="_blank"
          class="hero-btn inline-flex items-center gap-2 rounded-full border border-white/15 px-6 py-3 text-base font-medium text-text-primary transition-colors duration-150 hover:border-white/30 active:scale-[0.99]"
          style="animation-delay: 0.94s"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.082-.73.082-.73 1.205.085 1.838 1.236 1.838 1.236 1.07 1.835 2.81 1.305 3.495.998.108-.776.418-1.305.762-1.605-2.665-.305-5.467-1.332-5.467-5.93 0-1.31.467-2.38 1.236-3.22-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.3 1.23a11.5 11.5 0 0 1 3.003-.404c1.02.005 2.047.138 3.005.404 2.29-1.552 3.297-1.23 3.297-1.23.654 1.652.243 2.873.12 3.176.77.84 1.235 1.91 1.235 3.22 0 4.61-2.807 5.62-5.48 5.92.43.37.82 1.103.82 2.222 0 1.606-.014 2.898-.014 3.293 0 .322.216.694.825.576C20.565 22.092 24 17.594 24 12.297c0-6.627-5.373-12-12-12"></path>
          </svg>
          View on GitHub
        </a>
      </div>
    </div>

    <!-- Phone column -->
    <div class="hero-phone-col lg:col-span-5">
      <div class="relative mx-auto flex max-w-[320px] justify-center lg:max-w-none">
        <div
          aria-hidden="true"
          class="pointer-events-none absolute inset-0 -z-10"
          style="background: radial-gradient(circle, rgba(108,71,245,0.5) 0%, transparent 65%); filter: blur(55px);"
        ></div>
        <PhoneMockup src={heroScreenshot} alt="Cassette app on iPhone — home screen" />
      </div>
    </div>
  </div>
</section>

<style>
  /* ── Atmospheric ─────────────────────────────────────── */
  .hero-halo { animation: hero-halo-in 1.6s ease-out both; }

  .hero-grid {
    background-image: radial-gradient(circle, rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size: 36px 36px;
    animation: hero-halo-in 2.2s ease-out 0.3s both;
  }

  .orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    will-change: transform;
  }

  .orb-1 {
    width: clamp(300px, 48vw, 600px);
    height: clamp(240px, 38vw, 500px);
    top: -10%; right: -8%;
    background: radial-gradient(circle at 35% 45%, rgba(108,71,245,0.36) 0%, transparent 68%);
    animation: hero-halo-in 1.8s ease-out both, orb-drift-a 26s ease-in-out 1.8s infinite;
  }

  .orb-2 {
    width: clamp(240px, 38vw, 480px);
    height: clamp(240px, 38vw, 480px);
    bottom: 0; left: -6%;
    background: radial-gradient(circle at 60% 50%, rgba(128,96,247,0.26) 0%, transparent 68%);
    animation: hero-halo-in 1.8s ease-out 0.4s both, orb-drift-b 32s ease-in-out 2.2s infinite;
  }

  @keyframes orb-drift-a {
    0%   { transform: translate(0, 0) scale(1); }
    25%  { transform: translate(-24px, 26px) scale(1.04); }
    55%  { transform: translate(18px, -18px) scale(0.97); }
    80%  { transform: translate(-10px, 12px) scale(1.02); }
    100% { transform: translate(0, 0) scale(1); }
  }

  @keyframes orb-drift-b {
    0%   { transform: translate(0, 0) scale(1); }
    30%  { transform: translate(32px, -26px) scale(1.06); }
    65%  { transform: translate(-20px, 14px) scale(0.95); }
    100% { transform: translate(0, 0) scale(1); }
  }

  .hero-grain {
    background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='256' height='256'><filter id='g'><feTurbulence type='fractalNoise' baseFrequency='0.88' numOctaves='4' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='256' height='256' filter='url(%23g)' opacity='1'/></svg>");
    background-size: 220px 220px;
    opacity: 0.038;
    mix-blend-mode: overlay;
  }

  /* ── Line-mask reveal (above-fold = animation, not transition) */
  .lm-wrap {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }

  .lm-text {
    display: block;
    animation: line-up 1.05s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0s) both;
  }

  /* ── Shimmer ─────────────────────────────────────────── */
  .shimmer-text {
    background: linear-gradient(
      108deg,
      #8060F7 0%,
      #8060F7 26%,
      #C8B4FF 43%,
      #EDE6FF 50%,
      #C8B4FF 57%,
      #8060F7 74%,
      #8060F7 100%
    );
    background-size: 280% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation:
      line-up 1.05s cubic-bezier(0.22, 1, 0.36, 1) 0.54s both,
      text-shimmer 6s linear 3s infinite;
  }

  /* shimmer overrides line-up after it completes — both fill-mode handles this */
  @keyframes text-shimmer {
    0%   { background-position: 100% center; }
    100% { background-position: -180% center; }
  }

  /* ── Other entrances ─────────────────────────────────── */
  .hero-badge {
    animation: spring-in 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.08s both;
  }

  .hero-subtitle {
    animation: blur-in 0.95s cubic-bezier(0.22, 1, 0.36, 1) 0.66s both;
  }

  .hero-btn {
    animation: spring-in 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .hero-phone-col {
    animation: phone-entrance 1.15s cubic-bezier(0.22, 1, 0.36, 1) 0.42s both;
  }

  @media (prefers-reduced-motion: reduce) {
    .orb-1, .orb-2, .shimmer-text { animation: none !important; }
    .shimmer-text { color: #8060F7; background: none; -webkit-background-clip: unset; background-clip: unset; }
  }
</style>
