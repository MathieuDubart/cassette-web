---
import HeroPlatformSwitcher from "./HeroPlatformSwitcher.astro";
import MacInstall from "./MacInstall.astro";

const githubUrl = "https://github.com/CassetteLab/cassette";
const base = import.meta.env.BASE_URL;
const iphoneScreenshot = `${base}/images/header.jpeg`.replace(/\/+/g, "/");
const macScreenshot = `${base}/images/header_mac.png`.replace(/\/+/g, "/");
---

<section class="hero-section">

  <div class="hero-bg" aria-hidden="true">
    <div class="hero-grid"></div>
    <div class="hero-grain"></div>
    <div class="glow-a"></div>
    <div class="glow-b"></div>
  </div>

  <!-- Text content — vertically centered in upper portion of 100svh -->
  <div class="hero-content">

    <h1 class="hero-heading fade-up" style="--d: 0.08s">
      Your music,<br>
      your server,<br>
      <span class="hero-accent">your app.</span>
    </h1>

    <p class="hero-subtitle fade-up" style="--d: 0.16s">
      Cassette is a native iOS and macOS client for Subsonic and OpenSubsonic.
      Beautiful, fast, and built for people who self-host.
    </p>

    <div class="hero-actions fade-up" style="--d: 0.22s">
      <a
        href="https://testflight.apple.com/join/pxCpfpxF"
        rel="noopener"
        target="_blank"
        class="btn-primary"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" class="btn-icon" aria-hidden="true">
          <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
        </svg>
        TestFlight
      </a>

      <!-- Secondary link — underline style, no ghost button -->
      <a
        href={githubUrl}
        rel="noopener"
        target="_blank"
        class="btn-link"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" class="btn-icon" aria-hidden="true">
          <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.09-.745.082-.73.082-.73 1.205.085 1.838 1.236 1.838 1.236 1.07 1.835 2.81 1.305 3.495.998.108-.776.418-1.305.762-1.605-2.665-.305-5.467-1.332-5.467-5.93 0-1.31.467-2.38 1.236-3.22-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.3 1.23a11.5 11.5 0 0 1 3.003-.404c1.02.005 2.047.138 3.005.404 2.29-1.552 3.297-1.23 3.297-1.23.654 1.652.243 2.873.12 3.176.77.84 1.235 1.91 1.235 3.22 0 4.61-2.807 5.62-5.48 5.92.43.37.82 1.103.82 2.222 0 1.606-.014 2.898-.014 3.293 0 .322.216.694.825.576C20.565 22.092 24 17.594 24 12.297c0-6.627-5.373-12-12-12"/>
        </svg>
        View on GitHub
      </a>
    </div>

    <!-- macOS install — Homebrew, with copy-to-clipboard -->
    <MacInstall />

  </div>

  <!-- Device mockup — sits at bottom, naturally emerges past the fold -->
  <div class="hero-phone fade-up" style="--d: 0.1s">
    <HeroPlatformSwitcher
      iphoneScreenshot={iphoneScreenshot}
      iphoneAlt="Cassette app on iPhone — home screen"
      macScreenshot={macScreenshot}
      macAlt="Cassette app on Mac — main window"
    />
  </div>

</section>

<style>
  /* ── Section ─────────────────────────────────────────── */
  /* 100svh, flex-column: text takes flex:1 (centered), phone sits below */
  .hero-section {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    overflow-x: clip;
    display: flex;
    flex-direction: column;
    /* Soft radial from AccentSoft at the top — depth without flash */
    background: radial-gradient(
      ellipse 70% 55% at 50% 0%,
      rgba(34, 30, 56, 0.75) 0%,
      transparent 65%
    );
  }

  /* ── Background ──────────────────────────────────────── */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
    background-size: 36px 36px;
    opacity: 0;
    animation: fade-in-bg 1.6s ease-out 0.2s forwards;
  }

  .hero-grain {
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='256' height='256'><filter id='g'><feTurbulence type='fractalNoise' baseFrequency='0.88' numOctaves='4' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='256' height='256' filter='url(%23g)' opacity='1'/></svg>");
    background-size: 220px 220px;
    opacity: 0.032;
    mix-blend-mode: overlay;
  }

  .glow-a {
    position: absolute;
    top: -20%;
    right: -8%;
    width: clamp(420px, 58vw, 780px);
    height: clamp(340px, 50vw, 660px);
    background: radial-gradient(circle at 38% 42%, rgba(108, 71, 245, 0.38) 0%, transparent 60%);
    filter: blur(72px);
    will-change: transform;
    animation: breathe 38s ease-in-out infinite;
  }

  .glow-b {
    position: absolute;
    bottom: 2%;
    left: -8%;
    width: clamp(320px, 44vw, 560px);
    height: clamp(320px, 44vw, 560px);
    background: radial-gradient(circle at 55% 52%, rgba(128, 96, 247, 0.22) 0%, transparent 65%);
    filter: blur(80px);
  }

  @keyframes breathe {
    0%, 100% { transform: scale(1) translate(0, 0); }
    50%       { transform: scale(1.07) translate(-18px, 16px); }
  }

  @keyframes fade-in-bg {
    to { opacity: 1; }
  }

  /* ── Text content area ───────────────────────────────── */
  /* flex:1 so it fills remaining space; justify-content centers text vertically */
  .hero-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 7rem 1.5rem 2rem;   /* 7rem clears the fixed nav */
    max-width: 62rem;
    margin-inline: auto;
    width: 100%;
  }

  @media (min-width: 640px) {
    .hero-content { padding-inline: 2rem; }
  }

  /* ── Heading ─────────────────────────────────────────── */
  /* Bumped to spec: clamp(48px, 8vw, 96px), tighter line-height */
  .hero-heading {
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 700;
    line-height: 1.0;
    letter-spacing: -0.04em;
    color: var(--color-text-primary);
    margin: 0 0 1.5rem;
  }

  .hero-accent {
    background: linear-gradient(135deg, #9D85FF 0%, #C8BAFF 45%, #EDE8FF 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* ── Subtitle ────────────────────────────────────────── */
  /* clamp(18px, 2.5vw, 24px), centered via margin-inline auto */
  .hero-subtitle {
    font-size: clamp(1.125rem, 2.5vw, 1.5rem);
    font-weight: 400;
    line-height: 1.55;
    color: var(--color-text-secondary);
    max-width: 32.5rem;    /* ~520px */
    margin: 0 auto 2.5rem;
  }

  /* ── Actions ─────────────────────────────────────────── */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    justify-content: center;
  }

  /* ── Primary CTA ─────────────────────────────────────── */
  /* 14px radius (Apple sweet spot), 52px min-height, weight 600 */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.75rem;
    min-height: 52px;
    border-radius: 0.875rem;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    background-color: var(--color-accent-primary);
    color: #fff;
    box-shadow: 0 4px 16px rgba(108, 71, 245, 0.38);
    transition: background-color 180ms ease-out, box-shadow 180ms ease-out, transform 180ms ease-out;
  }

  .btn-icon {
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
  }

  .btn-primary:hover {
    background-color: var(--color-accent-hover);
    box-shadow: 0 6px 28px rgba(108, 71, 245, 0.6);
    transform: translateY(-2px);
  }

  .btn-primary:active { transform: none; }

  /* ── Secondary link ──────────────────────────────────── */
  /* No ghost border — underline only, AccentFg underline color */
  .btn-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: underline;
    text-decoration-color: var(--color-accent-fg);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: color 150ms ease;
  }

  .btn-link:hover {
    color: var(--color-text-primary);
  }

  /* ── Device column ───────────────────────────────────── */
  /* Flush to bottom of section — device "emerges" past the fold */
  .hero-phone {
    display: flex;
    justify-content: center;
    padding: 2rem 1.5rem 0;
  }

  @media (min-width: 640px) {
    .hero-phone { padding-inline: 2rem; }
  }

  /* ── Entrance animations (above-fold, keyframe-based) ── */
  .fade-up {
    animation: fade-up 0.6s ease-out var(--d, 0s) both;
  }

  @keyframes fade-up {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .fade-up   { animation: none; }
    .glow-a    { animation: none; }
    .hero-grid { animation: none; opacity: 1; }
  }

  @media (prefers-color-scheme: light) {
    .hero-section {
      background: radial-gradient(
        ellipse 70% 55% at 50% 0%,
        rgba(108, 71, 245, 0.07) 0%,
        transparent 65%
      );
    }

    .hero-grid {
      background-image: radial-gradient(circle, rgba(0, 0, 0, 0.07) 1px, transparent 1px);
    }

    .glow-a {
      background: radial-gradient(circle at 38% 42%, rgba(108, 71, 245, 0.14) 0%, transparent 60%);
    }

    .glow-b {
      background: radial-gradient(circle at 55% 52%, rgba(128, 96, 247, 0.08) 0%, transparent 65%);
    }

    .hero-accent {
      background: linear-gradient(135deg, #4A2DCC 0%, #6C47F5 45%, #8060F7 100%);
      -webkit-background-clip: text;
      background-clip: text;
    }

    .btn-primary {
      box-shadow: 0 4px 16px rgba(108, 71, 245, 0.28);
    }

    .btn-primary:hover {
      box-shadow: 0 6px 28px rgba(108, 71, 245, 0.45);
    }

    .btn-link {
      color: var(--color-text-secondary);
    }
  }
</style>
