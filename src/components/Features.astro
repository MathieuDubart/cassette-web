---
import FeatureBlock from "./FeatureBlock.astro";

const img = (path: string) =>
  `${import.meta.env.BASE_URL}/${path}`.replace(/\/+/g, "/");
---

<section id="features" class="features-section" aria-label="Features">
  <div class="features-container">

    <!-- Section intro -->
    <div class="features-intro reveal">
      <p class="features-eyebrow">
        <span class="eyebrow-dot"></span>
        Features
      </p>
    </div>

    <FeatureBlock
      heading="Crafted for iPhone."
      body="Native Swift and SwiftUI from the ground up. Liquid Glass design language on iOS 26+. No web wrappers, no Electron, no compromises. Cassette feels like it belongs on your phone because it does."
      macHeading="Crafted for Mac."
      macBody="Native Swift and SwiftUI from the ground up. Sidebar navigation, keyboard-driven browsing, and a menu bar player that stays out of your way. No web wrappers, no Electron, no compromises. Cassette feels like it belongs on your Mac because it does."
      screenshotPosition="right"
      screenshotSrc={img("images/crafted_for_iPhone.jpeg")}
      screenshotAlt="Cassette home screen on iPhone showing pinned albums and library rows"
      macScreenshotSrc={img("images/crafted_for_mac.png")}
      macScreenshotAlt="Cassette main window on Mac showing sidebar navigation and library"
      index={0}
    />
    <FeatureBlock
      heading="Listen offline. Really."
      body="Download albums and playlists for true offline access. Your music plays even without a connection — and so does your library, your search, your queue, your favorites. Nothing breaks when the network drops."
      screenshotPosition="left"
      screenshotSrc={img("images/listen_offline.jpeg")}
      screenshotAlt="Cassette in offline mode showing a downloaded album with airplane mode active"
      macScreenshotSrc={img("images/listen_offline_mac.png")}
      macScreenshotAlt="Cassette on Mac showing an offline-available album with downloaded badge"
      index={1}
    />
    <FeatureBlock
      heading="Designed for music lovers."
      body="Cover art that breathes color into the interface. FLAC and lossless badges so you always know what you're hearing. Pinned albums on your home screen, queue management, AirPlay, lock screen controls — every detail considered."
      macBody="Cover art that breathes color into the interface. FLAC and lossless badges so you always know what you're hearing. Global keyboard shortcuts, a persistent mini-player, and AirPlay to every speaker in the room — every detail considered."
      screenshotPosition="right"
      screenshotSrc={img("images/designed_for_music_lovers.jpeg")}
      screenshotAlt="Cassette full-screen player view with cover art and dominant color gradient"
      macScreenshotSrc={img("images/designed_for_music_lovers_mac.png")}
      macScreenshotAlt="Cassette player on Mac with mini-player and keyboard shortcut overlay"
      index={2}
    />
    <FeatureBlock
      heading="Yours forever."
      body="Open source under MPL-2.0. No accounts to create, no telemetry sent home, no ads served. Your music, your data, your app."
      screenshotPosition="left"
      screenshotSrc={img("images/yours_forever.jpeg")}
      screenshotAlt="Cassette settings view showing the no-tracking, open source, and GPL-3.0 statements"
      macScreenshotSrc={img("images/yours_forever_mac.png")}
      macScreenshotAlt="Cassette settings on Mac showing the open source and no-tracking statements"
      index={3}
    />

  </div>
</section>

<style>
  .features-section {
    position: relative;
  }

  .features-container {
    max-width: 80rem;
    margin-inline: auto;
    padding-inline: 1.5rem;
    padding-top: 5rem;    /* 80px mobile */
    padding-bottom: 2rem;
  }

  @media (min-width: 768px) {
    .features-container {
      padding-inline: 3rem;
      padding-top: 7.5rem;  /* 120px desktop */
    }
  }

  /* ── Section intro ───────────────────────────────────── */
  .features-intro {
    margin-bottom: 1rem;
  }

  .features-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-primary);
    margin: 0;
  }

  .eyebrow-dot {
    display: inline-block;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background-color: currentColor;
    flex-shrink: 0;
  }
</style>

<script>
  const setupFeatureReveal = () => {
    const blocks = document.querySelectorAll<HTMLElement>(".feature-block");
    if (blocks.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("feature-visible");
            observer.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.1, rootMargin: "0px 0px -40px 0px" }
    );

    blocks.forEach((block) => observer.observe(block));
  };

  setupFeatureReveal();
  document.addEventListener("astro:page-load", setupFeatureReveal);
</script>
