---
const githubUrl = "https://github.com/MathieuDubart/Cassette";
const logoUrl = `${import.meta.env.BASE_URL}/images/cassette-icon-1024.png`.replace(/\/+/g, "/");
---

<header id="site-nav" class="site-nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label="Cassette home">
      <img
        src={logoUrl}
        alt=""
        width="28"
        height="28"
        loading="eager"
        decoding="sync"
        class="nav-logo-img"
      />
      <span>Cassette</span>
    </a>

    <nav aria-label="Primary navigation">
      <a href="/#features" class="nav-link">Features</a>
      <a href="/contact" class="nav-link">Contact</a>
      <a href={githubUrl} rel="noopener" target="_blank" class="nav-link">GitHub</a>
    </nav>
  </div>
</header>

<style>
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    transition:
      background-color 0.35s ease,
      backdrop-filter  0.35s ease,
      -webkit-backdrop-filter 0.35s ease,
      border-color     0.35s ease;
    border-bottom: 1px solid transparent;
  }

  .site-nav.is-scrolled {
    background-color: rgba(15, 13, 26, 0.8);
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    border-bottom-color: rgba(108, 71, 245, 0.14);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 80rem;
    margin-inline: auto;
    padding-block: 1rem;
    padding-inline: 1.5rem;
  }

  @media (min-width: 640px) {
    .nav-inner {
      padding-block: 1.125rem;
      padding-inline: 2rem;
    }
  }

  .nav-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .nav-logo-img {
    width: 28px;
    height: 28px;
    border-radius: 0.5rem;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }

  .nav-link {
    display: inline-block;
    padding: 0.375rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .nav-link:hover {
    color: var(--color-text-primary);
  }
</style>

<script>
  const nav = document.getElementById("site-nav");
  const THRESHOLD = 20;

  const updateNav = () => {
    if (!nav) return;
    nav.classList.toggle("is-scrolled", window.scrollY > THRESHOLD);
  };

  const init = () => {
    updateNav();
    window.addEventListener("scroll", updateNav, { passive: true });
  };

  init();
  document.addEventListener("astro:page-load", init);
</script>
